---
// Sound on/off toggle. Behavior in scripts/widgets.ts (initSoundToggles);
// state persists to localStorage('sound-enabled').
---
<button data-sound-toggle class="p-2 cursor-pointer" aria-pressed="true" aria-label="Disable sound effects" title="Disable sound">
  <img class="w-12 h-12 pixelated" src="/Speaker-0.svg" alt="Sound enabled" width="56" height="56" />
</button>
