---
// Theme (torch) toggle. Behavior in scripts/widgets.ts (initThemeToggles):
// swaps icon, plays torch sound, persists choice to localStorage('theme').
---
<button data-theme-toggle class="p-2 relative cursor-pointer" aria-label="Toggle color scheme">
  <img class="w-20 h-20 pixelated" src="/light_mode.webp" alt="Theme Swapper Icon" width="32" height="32" />
</button>
