---
// Notes panel: tabbed list (SCRIBBLES = regular notes, TOME REVIEWS = book
// reviews) + one pre-rendered detail view per entry. All static HTML;
// scripts/notes.ts toggles tab/list/detail visibility.
//
// Content: one markdown file per entry; the folder decides the tab —
// src/notes/scribbles/*.md vs src/notes/tomes/*.md (schema in
// content.config.ts). Prev/Next navigates within the same tab.
import { getCollection, render } from 'astro:content';

const entries = await getCollection('notes');
const byDateDesc = (a: (typeof entries)[number], b: (typeof entries)[number]) =>
  b.data.date.getTime() - a.data.date.getTime();

const scribbles = entries.filter((e) => e.id.startsWith('scribbles/')).sort(byDateDesc);
const tomes = entries.filter((e) => e.id.startsWith('tomes/')).sort(byDateDesc);

const rendered = new Map<string, any>();
for (const entry of entries) {
  const { Content } = await render(entry);
  rendered.set(entry.id, Content);
}

const fmtDate = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;

// Rating row always shows 5 slots: full + (half?) + empty fillers.
const potions = (rating: number) => ({
  full: Math.floor(rating),
  half: rating % 1 !== 0,
  empty: 5 - Math.ceil(rating),
});

const tabs = [
  { key: 'scribbles', label: 'SCRIBBLES', items: scribbles },
  { key: 'tomes', label: 'TOME REVIEWS', items: tomes },
];
---

<div class="notes-root p-2 h-full pb-10">
  <!-- List view -->
  <div data-notes-list>
    <section class="h-full overflow-y-auto pb-32 flex flex-col items-center">
      <!-- Tabs -->
      <div class="flex gap-4 mt-6" role="tablist" aria-label="Note categories">
        {tabs.map((tab, i) => (
          <button
            data-notes-tab={tab.key}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            class:list={[
              'text-darker_secondary text-2xl px-4 py-0.5 border-4 border-secondary transition-all hover:cursor-pointer hover:bg-lighter_button focus:outline-none focus:ring-2 focus:ring-primary',
              i === 0 ? 'bg-primary' : 'bg-darker_primary',
            ]}
            style="font-family: AtlantisText; font-weight: 700;"
          >
            {tab.label}
          </button>
        ))}
      </div>

      {tabs.map((tab, i) => (
        <div data-notes-tab-panel={tab.key} class:list={['w-full max-w-2xl flex flex-col gap-4 mt-8', i !== 0 && 'hidden']}>
          {tab.items.length === 0 && (
            <p class="text-darker_secondary text-2xl text-center opacity-70" style="font-family: AtlantisText; font-weight: 400;">
              Nothing inscribed here yet...
            </p>
          )}
          {tab.items.map((entry) => (
            <button
              data-note-open={entry.id}
              class="border-6 border-secondary bg-darker_primary transition-all duration-200 shadow-lg w-full text-left text-darker_secondary text-3xl focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-bg flex flex-col items-start p-4 hover:bg-lighter_button hover:border-darker_secondary hover:cursor-pointer"
              style="font-family: AtlantisText; font-weight: 700;"
              aria-label={`Read ${tab.key === 'tomes' ? 'book review' : 'note'}: ${entry.data.title}, created on ${fmtDate(entry.data.date)}`}
            >
              <span class="flex w-full gap-4">
                {tab.key === 'tomes' && entry.data.cover && (
                  <img
                    src={entry.data.cover}
                    alt=""
                    class="w-28 h-40 object-contain border-4 border-secondary bg-primary p-0.5 pixelated self-start shrink-0"
                    loading="lazy"
                  />
                )}
                <span class="flex flex-col items-start flex-1 min-w-0">
                  <span class="flex w-full justify-between items-center">
                    <span>{entry.data.title}</span>
                    <span class="ml-2 text-3xl" style="font-family: AtlantisText; font-weight: 900;" aria-hidden="true">&gt;</span>
                  </span>
                  {tab.key === 'tomes' && entry.data.tags.length > 0 && (
                    <span class="flex flex-wrap gap-2 mt-2">
                      {entry.data.tags.map((tag) => (
                        <span class="text-darker_secondary text-sm border-2 border-secondary bg-primary px-1.5 py-0.5 whitespace-nowrap" style="font-family: AtlantisText; font-weight: 700;">
                          {tag}
                        </span>
                      ))}
                    </span>
                  )}
                  {tab.key === 'tomes' && entry.data.rating !== undefined && (
                    <span class="flex items-center gap-1 mt-2" aria-label={`Rated ${entry.data.rating} out of 5 potions`}>
                      {Array.from({ length: potions(entry.data.rating).full }).map(() => (
                        <span class="potion potion-full w-6 h-6" aria-hidden="true"></span>
                      ))}
                      {potions(entry.data.rating).half && (
                        <span class="potion potion-half w-6 h-6" aria-hidden="true"></span>
                      )}
                      {Array.from({ length: potions(entry.data.rating).empty }).map(() => (
                        <span class="potion potion-empty w-6 h-6" aria-hidden="true"></span>
                      ))}
                    </span>
                  )}
                  <span class="text-lg mt-2 opacity-70" style="font-family: AtlantisText; font-weight: 400;">
                    {entry.data.author ? `${entry.data.author} · ${fmtDate(entry.data.date)}` : fmtDate(entry.data.date)}
                  </span>
                </span>
              </span>
            </button>
          ))}
        </div>
      ))}
    </section>
  </div>

  <!-- Detail views (hidden until an entry is opened); Prev/Next stays inside the entry's own tab -->
  {tabs.map((tab) =>
    tab.items.map((entry, index) => {
      const Content = rendered.get(entry.id);
      return (
        <div data-note-detail={entry.id} class="hidden h-full">
          <section class="h-full overflow-y-auto pb-32 flex flex-col">
            <div class="flex items-center justify-between mb-6 mt-4">
              <button
                data-note-back
                class="text-darker_secondary text-4xl hover:opacity-70 transition-opacity hover:cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-bg"
                style="font-family: AtlantisText; font-weight: 900;"
                aria-label="Go back to notes list"
              >
                &lt;
              </button>
              <h1 class="text-darker_secondary text-4xl text-center flex-1" style="font-family: AtlantisText; font-weight: 700;">
                {entry.data.title}
              </h1>
              <div class="w-8"></div>
            </div>

            {tab.key === 'tomes' && (
              <div class="flex flex-col items-center mb-6 gap-2">
                {entry.data.tags.length > 0 && (
                  <div class="flex gap-2 -mt-4 mb-2">
                    {entry.data.tags.map((tag) => (
                      <span class="text-darker_secondary text-lg border-4 border-secondary bg-darker_primary px-2 py-0.5" style="font-family: AtlantisText; font-weight: 700;">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
                {entry.data.cover && (
                  <img
                    src={entry.data.cover}
                    alt={`Cover of ${entry.data.title}`}
                    class="max-h-64 object-contain border-4 border-secondary bg-darker_primary p-1 pixelated"
                    loading="lazy"
                  />
                )}
                {entry.data.author && (
                  <p class="text-darker_secondary text-2xl" style="font-family: AtlantisText; font-weight: 500;">
                    by {entry.data.author}
                  </p>
                )}
                {entry.data.rating !== undefined && (
                  <span class="flex items-center gap-1" aria-label={`Rated ${entry.data.rating} out of 5 potions`}>
                    {Array.from({ length: potions(entry.data.rating).full }).map(() => (
                      <span class="potion potion-full w-8 h-8" aria-hidden="true"></span>
                    ))}
                    {potions(entry.data.rating).half && (
                      <span class="potion potion-half w-8 h-8" aria-hidden="true"></span>
                    )}
                    {Array.from({ length: potions(entry.data.rating).empty }).map(() => (
                      <span class="potion potion-empty w-8 h-8" aria-hidden="true"></span>
                    ))}
                  </span>
                )}
              </div>
            )}

            <div class="flex-1 mb-6">
              <div
                class="text-darker_secondary text-2xl leading-relaxed [&>p]:mb-4 [&_a]:underline [&_a]:decoration-2 [&_em]:italic"
                style="font-family: AtlantisText; font-weight: 400;"
              >
                <Content />
              </div>
              <div class="text-darker_secondary text-lg mt-6 opacity-70" style="font-family: AtlantisText; font-weight: 400;">
                Created: {fmtDate(entry.data.date)}
              </div>
            </div>

            <div class="flex justify-center items-center mt-4 gap-8">
              <button
                data-note-prev={index > 0 ? tab.items[index - 1].id : undefined}
                disabled={index === 0}
                class="text-darker_secondary text-2xl px-4 py-2 border-6 border-secondary bg-darker_primary disabled:opacity-50 disabled:cursor-not-allowed hover:bg-lighter_button hover:opacity-100 transition-all hover:cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-bg"
                style="font-family: AtlantisText; font-weight: 700;"
                aria-label="Go to previous note"
              >
                Previous
              </button>
              <span class="text-darker_secondary text-xl" style="font-family: AtlantisText; font-weight: 400;" aria-live="polite">
                {index + 1} of {tab.items.length}
              </span>
              <button
                data-note-next={index < tab.items.length - 1 ? tab.items[index + 1].id : undefined}
                disabled={index === tab.items.length - 1}
                class="text-darker_secondary text-2xl px-4 py-2 border-6 border-secondary bg-darker_primary disabled:opacity-50 disabled:cursor-not-allowed hover:bg-lighter_button hover:opacity-100 transition-all hover:cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-bg"
                style="font-family: AtlantisText; font-weight: 700;"
                aria-label="Go to next note"
              >
                Next
              </button>
            </div>
          </section>
        </div>
      );
    })
  )}
</div>
