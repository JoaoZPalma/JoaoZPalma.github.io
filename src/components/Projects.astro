---
// Project list. Edit src/data/projects.json to add/remove projects —
// descriptions are HTML strings (rendered with set:html).
import projects from '../data/projects.json';
---

<div class="p-2 h-full">
  <section class="h-full overflow-y-auto pb-32">
    <ul class="mr-8">
      {projects.map((project, index) => (
        <>
          <li class:list={['flex items-start my-6 md:mb-14 flex-col md:flex-row', index % 2 === 1 && 'md:flex-row-reverse']}>
            <div class:list={['flex items-start gap-4 md:contents', index % 2 === 1 ? 'flex-row-reverse' : 'text-right']}>
              <img
                class:list={[
                  'aspect-square w-[10vh] h-[10vh] md:w-40 md:h-40 object-cover border-secondary border-4 bg-darker_primary p-1 mb-4 md:mb-0',
                  index % 2 === 1 ? ' md:self-start' : 'self-start',
                ]}
                src={project.image}
                alt={project.title}
                width="160"
                height="160"
                loading="lazy"
              />
              <h2 class="text-darker_secondary text-4xl md:hidden" style="font-family: AtlantisText; font-weight: 700;">
                {project.title}
              </h2>
            </div>
            <article class:list={['flex-1 text-end md:-mt-2', index % 2 === 1 ? 'text-start md:mr-4 md:ml-2' : 'md:ml-4 md:mr-2']}>
              <h2 class="text-darker_secondary text-4xl hidden md:block" style="font-family: AtlantisText; font-weight: 700;">
                {project.title}
              </h2>
              <p class="text-darker_secondary text-2xl" style="font-family: AtlantisText; font-weight: 400;" set:html={project.description} />
              {project.available ? (
                <a
                  href={project.link}
                  class="text-darker_secondary text-2xl underline decoration-2 hover:decoration-wavy hover:decoration-1"
                  style="font-family: AtlantisText; font-weight: 400;"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Check it out here!
                </a>
              ) : (
                <div class:list={['flex gap-2 flex-col md:flex-row', index % 2 === 1 && 'md:flex-row-reverse']}>
                  <span class="text-darker_secondary text-2xl line-through decoration-2" style="font-family: AtlantisText; font-weight: 400;">
                    Check it out here!
                  </span>
                  <span class="text-darker_secondary text-xl italic -mb-2" style="font-family: AtlantisText; font-weight: 400;">
                    {project.unavailableComment}
                  </span>
                </div>
              )}
            </article>
          </li>
          {index < projects.length - 1 && (
            <li class="md:hidden flex justify-center">
              <div class="text-darker_secondary text-4xl leading-none" style="font-family: AtlantisText; font-weight: 400;">
                -----------------------
              </div>
            </li>
          )}
        </>
      ))}
    </ul>
  </section>
</div>
