---
// Contact panel: raven blurb, email button, social links. Pure static HTML.
---

<!-- Mobile Layout - with flex-grow spacing -->
<div class="md:hidden p-2 h-full flex flex-col items-center justify-center" aria-label="Contact information">
  <div class="flex-grow flex flex-col items-center justify-end">
    <p class="text-darker_secondary text-4xl text-center" style="font-family: AtlantisText; font-weight: 400;">
      "My raven delivery service is <span class="font-bold">always open.</span><br />
      Send a message!&mdash;I don't bite (much)."
    </p>
    <div class="w-full flex items-center justify-center">
      <img src="/contactCrow.webp" alt="Cool image of a Crow" class="w-[60%]" width="800" height="600" loading="lazy" />
    </div>
    <p class="text-darker_secondary text-4xl text-center" style="font-family: AtlantisText; font-weight: 400;">
      email me at: <a href="mailto:joaozpalma@gmail.com" class="underline decoration-3 hover:decoration-4">joaozpalma@gmail.com</a><br />
      or <b>press the button below</b> to magically open your email app.
    </p>
  </div>

  <div class="w-full flex items-center justify-center my-8">
    <div class="w-max border-6 border-darker_secondary pr-2 pl-2 bg-darker_primary flex items-center justify-center hover:cursor-pointer hover:bg-black/15">
      <a
        href="mailto:joaozpalma@gmail.com"
        class="text-darker_secondary text-4xl hover:cursor-pointer items-center p-1 pt-2"
        style="font-family: AtlantisText; font-weight: 900;"
      >
        CAST &nbsp;"EMAIL"
      </a>
    </div>
  </div>

  <div class="flex-grow flex flex-col items-center justify-start">
    <p class="text-darker_secondary text-4xl" style="font-family: AtlantisText; font-weight: 400;">
      or find me on:
    </p>
    <div class="h-max flex items-center justify-center gap-4 mt-2">
      <a href="https://www.linkedin.com/in/joaozpalma/" target="_blank" rel="noopener noreferrer">
        <img src="/linkedinIcone.webp" alt="LinkedIn" class="w-[75px] h-[75px] hover:opacity-80" width="75" height="75" loading="lazy" />
      </a>
      <a href="https://www.github.com/joaozpalma/" target="_blank" rel="noopener noreferrer">
        <img src="/githubIcone.webp" alt="Github" class="w-[75px] h-[75px] hover:opacity-80" width="75" height="75" loading="lazy" />
      </a>
    </div>
  </div>
</div>

<!-- Desktop Layout - original layout -->
<div class="hidden md:flex md:flex-col md:items-center md:justify-center p-2 min-h-[400px] max-h-screen my-2 md:my-0" aria-label="Contact information">
  <p class="text-darker_secondary text-4xl text-center" style="font-family: AtlantisText; font-weight: 400;">
    "My raven delivery service is <span class="font-bold">always open.</span><br />
    Send a message!&mdash;I don't bite (much)."
  </p>
  <div class="w-full flex items-center justify-center">
    <img src="/contactCrow.webp" alt="Cool image of a Crow" class="w-[60%]" width="800" height="600" loading="lazy" />
  </div>
  <p class="text-darker_secondary text-4xl text-center" style="font-family: AtlantisText; font-weight: 400;">
    email me at: <a href="mailto:joaozpalma@gmail.com" class="underline decoration-3 hover:decoration-4">joaozpalma@gmail.com</a><br />
    or <b>press the button below</b> to magically open your email app.
  </p>
  <div class="w-full flex flex-col items-center justify-center mt-5">
    <div class="w-max border-6 border-darker_secondary pr-2 pl-2 bg-darker_primary flex items-center justify-center hover:cursor-pointer hover:bg-black/15">
      <a
        href="mailto:joaozpalma@gmail.com"
        class="text-darker_secondary text-4xl hover:cursor-pointer items-center p-1 pt-2"
        style="font-family: AtlantisText; font-weight: 900;"
      >
        CAST &nbsp;"EMAIL"
      </a>
    </div>
    <p class="text-darker_secondary text-4xl mt-3" style="font-family: AtlantisText; font-weight: 400;">
      or find me on:
    </p>
    <div class="h-max flex items-center justify-center gap-4 mt-2">
      <a href="https://www.linkedin.com/in/joaozpalma/" target="_blank" rel="noopener noreferrer">
        <img src="/linkedinIcone.webp" alt="LinkedIn" class="w-[75px] h-[75px] hover:opacity-80" width="75" height="75" loading="lazy" />
      </a>
      <a href="https://www.github.com/joaozpalma/" target="_blank" rel="noopener noreferrer">
        <img src="/githubIcone.webp" alt="Github" class="w-[75px] h-[75px] hover:opacity-80" width="75" height="75" loading="lazy" />
      </a>
    </div>
  </div>
</div>
